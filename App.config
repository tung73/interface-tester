<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<appSettings>
		<add key="LogDirectory" value="logs" />

		<add key="ConnectionTimeoutSeconds" value="30" />
		<add key="TlsHandshakeTimeoutSeconds" value="30" />
		<add key="HttpTimeoutSeconds" value="30" />
		<add key="ResponsePreviewChars" value="2000" />

		<!--
		  TEMPORARY DIAGNOSTIC SETTING (same as the original CAPS tester).
		  false = do NOT perform CRL / OCSP revocation checking.
		  The server certificate is still checked for trust, name, expiry, etc.
		-->
		<add key="CheckCertificateRevocation" value="false" />

		<!--
		  false = reject untrusted / name-mismatch / expired server certificates.
		  Set true only for lab diagnosis against an internal CA that is not in the store.
		-->
		<add key="AcceptUntrustedServerCertificates" value="false" />

		<!--
		  Windows Schannel proof.
		  true = run netsh trace (Schannel ETW providers by GUID) around the tests
		  and save etl/txt/excerpt into the run log folder.
		  Requires Administrator. A failed trace does not fail the SOAP tests.
		-->
		<add key="CaptureSchannelTrace" value="true" />
		<add key="CaptureSchannelPackets" value="false" />

		<!--
		  Interfaces. Number them Interface1, Interface2, Interface3, ...
		  The tester stops at the first missing InterfaceN.Name.

		  Required: Name, Url, P12Path
		  Optional: P12Password, Enabled, Probes, SoapAction, SoapEnvelopePath,
		            ContentType, AcceptUntrustedServerCertificate

		  Probes: tls, http, wsdl, soap (comma-separated)
		  soap runs two POSTs: TLS 1.2 only, then TLS 1.3 only.
		  SoapAction can be empty (CAPS WLS testConnection).
		-->

		<add key="Interface1.Name" value="CAPS-WLS-UAT" />
		<add key="Interface1.Url" value="https://uat.wls.caps.customs.hksarg:8102/rcaps_ws/CapsCommonInterfaceServiceForDCS" />
		<add key="Interface1.P12Path" value="C:\Users\victor_yt_lam\Documents\Certs\CAPS\dcs2025\uat.int.2025.p12" />
		<add key="Interface1.P12Password" value="Dcs2023" />
		<add key="Interface1.Enabled" value="true" />
		<add key="Interface1.Probes" value="tls,soap" />
		<add key="Interface1.SoapAction" value="" />
		<add key="Interface1.SoapEnvelopePath" value="soap\CapsTestConnection.xml" />

		<add key="Interface2.Name" value="DCS-CAPS-UAT" />
		<add key="Interface2.Url" value="https://uat.int.dcs.customs.hksarg:8443/CAPS/WebServices.asmx" />
		<add key="Interface2.P12Path" value="C:\Users\victor_yt_lam\Documents\Certs\CAPS\dcs2025\uat.int.2025.p12" />
		<add key="Interface2.P12Password" value="Dcs2023" />
		<add key="Interface2.Enabled" value="true" />
		<add key="Interface2.Probes" value="tls,soap" />
		<add key="Interface2.SoapAction" value="http://tempuri.org/Test" />
		<add key="Interface2.SoapEnvelopePath" value="soap\TestRequest.xml" />

		<add key="Interface3.Name" value="DCS-OCR-DEV" />
		<add key="Interface3.Url" value="https://dev.ext.dcs.customs.hksarg:8443/OCR/WebServices.asmx" />
		<add key="Interface3.P12Path" value="C:\Users\victor_yt_lam\Documents\Certs\CAPS\dcs2025\uat.int.2025.p12" />
		<add key="Interface3.P12Password" value="Dcs2023" />
		<add key="Interface3.Enabled" value="true" />
		<add key="Interface3.Probes" value="tls,soap" />
		<add key="Interface3.SoapAction" value="http://tempuri.org/Test" />
		<add key="Interface3.SoapEnvelopePath" value="soap\TestRequest.xml" />
	</appSettings>
	<system.net>
		<settings>
			<servicePointManager expect100Continue="false" />
		</settings>
	</system.net>
</configuration>
