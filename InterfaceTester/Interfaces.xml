<?xml version="1.0" encoding="utf-8" ?>
<interfaces>
	<!--
	  Universal connection tester endpoints.
	  Each interface MUST use its own P12 client certificate.

	  probes:
	    tls   = TCP connect + mutual TLS handshake for TLS 1.0 / 1.1 / 1.2 / 1.3
	    http  = HTTPS GET of the service URL (proves HTTP over mTLS)
	    wsdl  = HTTPS GET of ?wsdl
	    soap  = HTTPS POST of the SOAP envelope (ASMX Test by default)

	  Optional attributes:
	    enabled="false"
	    acceptUntrustedServerCertificate="true"
	    contentType="text/xml; charset=utf-8"
	-->

	<interface
		name="CAPS-WLS-UAT"
		url="https://uat.wls.caps.customs.hksarg:8102/rcaps_ws/CapsCommonInterfaceServiceForDCS"
		p12Path="certs\caps-wls-uat.p12"
		p12Password="CHANGE_ME"
		probes="tls,soap"
		soapAction=""
		soapEnvelopePath="soap\CapsTestConnection.xml" />

	<interface
		name="DCS-CAPS-UAT"
		url="https://uat.int.dcs.customs.hksarg:8443/CAPS/WebServices.asmx"
		p12Path="certs\dcs-caps-uat.p12"
		p12Password="CHANGE_ME"
		probes="tls,soap"
		soapAction="http://tempuri.org/Test"
		soapEnvelopePath="soap\TestRequest.xml" />

	<interface
		name="DCS-OCR-DEV"
		url="https://dev.ext.dcs.customs.hksarg:8443/OCR/WebServices.asmx"
		p12Path="certs\dcs-ocr-dev.p12"
		p12Password="CHANGE_ME"
		probes="tls,soap"
		soapAction="http://tempuri.org/Test"
		soapEnvelopePath="soap\TestRequest.xml" />
</interfaces>
